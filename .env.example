# =============================================================================
# AI Router Dashboard: variables de entorno
# Copia este archivo a .env y ajusta los valores. Nunca subas .env a git.
#   - docker compose lo lee automáticamente.
#   - El backend en local también lo lee (backend/.env, si existe, tiene prioridad).
#   - El frontend en local usa frontend/.env.local (ver frontend/.env.example).
# =============================================================================

# --- General -----------------------------------------------------------------

# Entorno de ejecución: development | test | staging | production.
# En development el backend arranca con autoreload (python main.py).
ENVIRONMENT=development

# Nivel de log del backend (salida JSON): DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# --- URLs ----------------------------------------------------------------------

# URL pública del backend, tal y como la ve el NAVEGADOR (sin barra final ni /api/v1).
# En Docker se incrusta en el frontend al construir la imagen (NEXT_PUBLIC_API_URL).
API_URL=http://localhost:8010

# URL pública del frontend. El backend la permite siempre en CORS.
FRONTEND_URL=http://localhost:3000

# Orígenes CORS adicionales, separados por comas (opcional).
CORS_ORIGINS=http://127.0.0.1:3000

# --- Backend en local (python main.py) ----------------------------------------

HOST=127.0.0.1
PORT=8010

# --- Puertos publicados por docker compose -------------------------------------

FRONTEND_PORT=3000
BACKEND_PORT=8010
POSTGRES_PORT=5432

# --- PostgreSQL ------------------------------------------------------------------

# El backend se conecta con estas variables (en local, a localhost:POSTGRES_PORT).
POSTGRES_DB=ai_router
POSTGRES_USER=ai_router
# Obligatoria para docker compose. Usa un valor propio, no este.
POSTGRES_PASSWORD=change-me

# Alternativa: URL completa con driver asíncrono; si está definida, tiene prioridad.
# DATABASE_URL=postgresql+asyncpg://ai_router:change-me@localhost:5432/ai_router

# docker compose: cargar el catálogo de modelos de ejemplo al arrancar el backend.
SEED_DATABASE=true

# --- Ejecución de modelos (ADR-0001) ---------------------------------------------

# POST /api/v1/completions. Desactivado por defecto: ejecutar modelos cuesta dinero.
# Mientras esté en false, el endpoint responde 503.
COMPLETIONS_ENABLED=false
# Timeout por defecto de cada ejecución, en segundos.
# COMPLETIONS_TIMEOUT_SECONDS=60
