{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Router API",
    "description": "Backend del AI Router Dashboard: selección automática de modelos de IA.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get Health",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/route": {
      "post": {
        "tags": [
          "router"
        ],
        "summary": "Route Prompt",
        "description": "Analiza el prompt y devuelve el modelo seleccionado (simulado).",
        "operationId": "route_prompt",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "List Models",
        "description": "Catálogo persistente de modelos con su precio vigente.",
        "operationId": "list_models",
        "parameters": [
          {
            "name": "active_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Devolver solo los modelos activos.",
              "default": false,
              "title": "Active Only"
            },
            "description": "Devolver solo los modelos activos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelListResponse"
                }
              }
            }
          },
          "503": {
            "description": "Ejecución desactivada, proveedor no configurado o no disponible, o catálogo no disponible (`completions_disabled`, `provider_not_configured`, `provider_unavailable`, `catalog_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/completions": {
      "post": {
        "tags": [
          "completions"
        ],
        "summary": "Create Completion",
        "description": "Decide el modelo (igual que /route) y lo ejecuta con el inference provider del catálogo.",
        "operationId": "create_completion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "El proveedor rechazó la petición (`provider_bad_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "El proveedor limitó la petición (`provider_rate_limited`), con `Retry-After`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Modelo no disponible, credenciales rechazadas u otro error del proveedor (`model_not_available`, `provider_auth_error`, `provider_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Ejecución desactivada, proveedor no configurado o no disponible, o catálogo no disponible (`completions_disabled`, `provider_not_configured`, `provider_unavailable`, `catalog_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "El proveedor no respondió a tiempo (`provider_timeout`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompletionCreateRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Prompt",
            "description": "Prompt del usuario."
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 8192.0,
            "minimum": 1.0,
            "title": "Max Output Tokens",
            "description": "Tope de tokens de salida.",
            "default": 512
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "CompletionCreateRequest",
        "examples": [
          {
            "prompt": "Resume este correo para mi equipo"
          }
        ]
      },
      "CompletionResponse": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/RouteResponse"
          },
          "completion": {
            "$ref": "#/components/schemas/CompletionResultResponse"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "completion"
        ],
        "title": "CompletionResponse"
      },
      "CompletionResultResponse": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          },
          "inference_provider": {
            "type": "string",
            "title": "Inference Provider",
            "description": "Sistema que ejecutó el modelo (p. ej. fake)."
          },
          "provider_model_id": {
            "type": "string",
            "title": "Provider Model Id",
            "description": "Modelo usado realmente en ese sistema."
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "stop",
              "length",
              "content_filter",
              "error"
            ],
            "title": "Finish Reason"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageResponse"
          },
          "cost": {
            "$ref": "#/components/schemas/CostResponse"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms",
            "description": "Latencia medida por el backend."
          },
          "provider_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Request Id"
          }
        },
        "type": "object",
        "required": [
          "content",
          "inference_provider",
          "provider_model_id",
          "finish_reason",
          "usage",
          "cost",
          "latency_ms",
          "provider_request_id"
        ],
        "title": "CompletionResultResponse"
      },
      "CostResponse": {
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0.0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Código ISO 4217."
          },
          "source": {
            "type": "string",
            "enum": [
              "reported",
              "estimated_from_catalog"
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "currency",
          "source"
        ],
        "title": "CostResponse"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Mensaje fijo para el código; nunca texto de un proveedor."
          },
          "code": {
            "type": "string",
            "enum": [
              "completions_disabled",
              "provider_not_configured",
              "provider_unavailable",
              "provider_timeout",
              "provider_rate_limited",
              "provider_auth_error",
              "provider_bad_request",
              "model_not_available",
              "catalog_unavailable",
              "provider_error"
            ],
            "title": "Code"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Mismo valor que la cabecera X-Request-ID."
          }
        },
        "type": "object",
        "required": [
          "detail",
          "code",
          "request_id"
        ],
        "title": "ErrorResponse",
        "description": "Error de la API, salvo la validación de la petición (422).",
        "examples": [
          {
            "code": "provider_timeout",
            "detail": "El proveedor no respondió a tiempo.",
            "request_id": "6f1c2b8e-3d4a-4f5b-9c6d-7e8f9a0b1c2d"
          }
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "ModelId": {
        "type": "string",
        "enum": [
          "claude-sonnet",
          "gemini",
          "gpt",
          "deepseek"
        ],
        "title": "ModelId"
      },
      "ModelListResponse": {
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelResponse"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "required": [
          "models"
        ],
        "title": "ModelListResponse",
        "examples": [
          {
            "models": [
              {
                "active": true,
                "context_window": 200000,
                "current_price": {
                  "currency": "USD",
                  "input_cost_per_million": 2.5,
                  "output_cost_per_million": 12.0
                },
                "display_name": "Claude Sonnet",
                "id": "6f1c2b8e-3d4a-4f5b-9c6d-7e8f9a0b1c2d",
                "model_key": "claude-sonnet",
                "provider": "anthropic"
              }
            ]
          }
        ]
      },
      "ModelPriceResponse": {
        "properties": {
          "input_cost_per_million": {
            "type": "number",
            "minimum": 0.0,
            "title": "Input Cost Per Million",
            "description": "Coste por millón de tokens de entrada."
          },
          "output_cost_per_million": {
            "type": "number",
            "minimum": 0.0,
            "title": "Output Cost Per Million",
            "description": "Coste por millón de tokens de salida."
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Código ISO 4217."
          }
        },
        "type": "object",
        "required": [
          "input_cost_per_million",
          "output_cost_per_million",
          "currency"
        ],
        "title": "ModelPriceResponse"
      },
      "ModelResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model_key": {
            "type": "string",
            "title": "Model Key"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "context_window": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Context Window",
            "description": "Tokens de contexto."
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "description": "Si el modelo está disponible para el enrutado."
          },
          "current_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelPriceResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "Precio vigente; null si no tiene."
          }
        },
        "type": "object",
        "required": [
          "id",
          "provider",
          "model_key",
          "display_name",
          "context_window",
          "active",
          "current_price"
        ],
        "title": "ModelResponse"
      },
      "RouteRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Prompt",
            "description": "Prompt del usuario."
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "RouteRequest",
        "examples": [
          {
            "prompt": "Diseña una arquitectura SaaS"
          }
        ]
      },
      "RouteResponse": {
        "properties": {
          "selected_model": {
            "$ref": "#/components/schemas/ModelId"
          },
          "complexity": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Complexity"
          },
          "estimated_cost": {
            "type": "number",
            "minimum": 0.0,
            "title": "Estimated Cost",
            "description": "Coste estimado en €."
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Estimated Tokens"
          },
          "matched_keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Keywords"
          },
          "is_fallback": {
            "type": "boolean",
            "title": "Is Fallback"
          }
        },
        "type": "object",
        "required": [
          "selected_model",
          "complexity",
          "estimated_cost",
          "reason",
          "model_name",
          "provider",
          "estimated_tokens",
          "matched_keywords",
          "is_fallback"
        ],
        "title": "RouteResponse",
        "examples": [
          {
            "complexity": 8,
            "estimated_cost": 0.0181,
            "estimated_tokens": 1207,
            "is_fallback": false,
            "matched_keywords": [
              "arquitectura"
            ],
            "model_name": "Claude Sonnet",
            "provider": "Anthropic",
            "reason": "Arquitectura software avanzada",
            "selected_model": "claude-sonnet"
          }
        ]
      },
      "UsageResponse": {
        "properties": {
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "source": {
            "type": "string",
            "enum": [
              "reported",
              "estimated"
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "source"
        ],
        "title": "UsageResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
